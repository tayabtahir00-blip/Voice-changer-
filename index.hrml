<!DOCTYPE html>
<html>
<head>
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>JRDN Voice Generator</title>
<style>
body{background:#111;color:#fff;font-family:sans-serif;padding:20px}
h2{text-align:center}
textarea{width:100%;height:140px;border-radius:10px;padding:12px;font-size:16px}
select,button{width:100%;padding:14px;margin-top:12px;border-radius:10px;font-size:16px;border:none}
button{background:#ff2d55;color:#fff;font-weight:bold}
audio{width:100%;margin-top:15px}
a{display:block;text-align:center;margin-top:10px;color:#4cd964;font-size:17px}
</style>
</head>
<body>
<h2>🎙️ JRDN Voice Generator</h2>
<p>Paste Asiya Script Here:</p>
<textarea id="text" placeholder="Paste your script here... Example: Asiya was the wife of Pharaoh, but her heart belonged to Allah..."></textarea>

<select id="voice">
<option value="Emma">Emma - USA Girl Soft</option>
<option value="Joanna">Joanna - USA Girl Clear</option>
<option value="Brian">Brian - USA Boy</option>
<option value="Matthew">Matthew - USA Boy Deep</option>
<option value="Aria">Aria - USA Girl Emotional</option>
</select>

<button onclick="makeVoice()">Generate Voice</button>
<audio id="player" controls style="display:none"></audio>
<a id="dl" style="display:none" download="jrdn-voice.mp3">⬇️ Download Voice</a>
<p id="msg" style="text-align:center;color:#aaa"></p>

<script>
async function makeVoice(){
let t=document.getElementById('text').value.trim();
let v=document.getElementById('voice').value;
if(!t){alert('Pehle script likho');return;}
document.getElementById('msg').innerText='Generating... thora wait karo...';
let url='https://api.streamelements.com/kappa/v2/speech?voice='+v+'&text='+encodeURIComponent(t);
let res=await fetch(url);
let blob=await res.blob();
let audioUrl=URL.createObjectURL(blob);
let p=document.getElementById('player');
p.src=audioUrl; p.style.display='block'; p.play();
let d=document.getElementById('dl');
d.href=audioUrl; d.style.display='block';
document.getElementById('msg').innerText='Ho gaya! Neeche se download kar lo.';
}
</script>
</body>
</html>
